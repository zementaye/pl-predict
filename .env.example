TELEGRAM_BOT_TOKEN=your_bot_token_here
FOOTBALL_DATA_API_KEY=your_api_key_here
DATABASE_URL=your_neon_connection_string_here
# URL of the deployed web app (webapp.py) — used by the bot to build the
# /app button and menu button. Leave unset until you've deployed it.
WEBAPP_URL=https://your-webapp-service.onrender.com
# Registered player name (must match exactly what /players shows, case
# insensitive) who sees the points-adjuster (the gear icon) on the League
# table in the web app. Leave blank/unset to hide it from everyone.
ADMIN_NAME=Zemen
